m prst="roundRect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="16213E"/></a:solidFill><a:ln w="15240"><a:solidFill><a:srgbClr val="334155"/></a:solidFill></a:ln></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="3"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="2"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="lt1"/></a:fontRef></p:style><p:txBody><a:bodyPr rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="9" name="TextBox 8"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="960120" y="1737360"/><a:ext cx="4800600" cy="1737360"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:spcAft><a:spcPts val="600"/></a:spcAft><a:defRPr sz="1400" b="1"><a:solidFill><a:srgbClr val="38BDF8"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>1. Severe Academic Fragmentation</a:t></a:r></a:p><a:p><a:pPr><a:defRPr sz="1150"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>Traditional university workflows force students and professors to navigate 5+ disjointed web applications for attendance, class timetables, marks, circulars, and certificates. Critical data is isolated in siloed portals with zero cross-talk.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="10" name="Rounded Rectangle 9"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6172200" y="1554480"/><a:ext cx="5257800" cy="2103120"/></a:xfrm><a:prstGeom prst="roundRect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="16213E"/></a:solidFill><a:ln w="15240"><a:solidFill><a:srgbClr val="334155"/></a:solidFill></a:ln></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="3"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="2"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="lt1"/></a:fontRef></p:style><p:txBody><a:bodyPr rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="11" name="TextBox 10"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6400800" y="1737360"/><a:ext cx="4800600" cy="1737360"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:spcAft><a:spcPts val="600"/></a:spcAft><a:defRPr sz="1400" b="1"><a:solidFill><a:srgbClr val="10B981"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>2. Coordination &amp; Free-Time Bottlenecks</a:t></a:r></a:p><a:p><a:pPr><a:defRPr sz="1150"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>University schedules run on 9 distinct 50-minute periods daily with rotating lab and elective batches. Organizing peer study groups, project sprint meets, and hackathons requires manual back-and-forth comparison, leading to constant scheduling friction.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="12" name="Rounded Rectangle 11"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="731520" y="3840480"/><a:ext cx="5257800" cy="2103120"/></a:xfrm><a:prstGeom prst="roundRect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="16213E"/></a:solidFill><a:ln w="15240"><a:solidFill><a:srgbClr val="334155"/></a:solidFill></a:ln></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="3"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="2"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="lt1"/></a:fontRef></p:style><p:txBody><a:bodyPr rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="13" name="TextBox 12"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="960120" y="4023360"/><a:ext cx="4800600" cy="1737360"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:spcAft><a:spcPts val="600"/></a:spcAft><a:defRPr sz="1400" b="1"><a:solidFill><a:srgbClr val="38BDF8"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>3. Unverified Digital Credentialing</a:t></a:r></a:p><a:p><a:pPr><a:defRPr sz="1150"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>Students lack a centralized, verifiable academic repository. Achievement certificates, semester grade sheets, and competition credentials get scattered in personal storage with no tamper-evident provenance or structured institutional verification.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="14" name="Rounded Rectangle 13"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6172200" y="3840480"/><a:ext cx="5257800" cy="2103120"/></a:xfrm><a:prstGeom prst="roundRect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="16213E"/></a:solidFill><a:ln w="15240"><a:solidFill><a:srgbClr val="334155"/></a:solidFill></a:ln></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="3"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="2"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="lt1"/></a:fontRef></p:style><p:txBody><a:bodyPr rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="15" name="TextBox 14"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="6400800" y="4023360"/><a:ext cx="4800600" cy="1737360"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:spcAft><a:spcPts val="600"/></a:spcAft><a:defRPr sz="1400" b="1"><a:solidFill><a:srgbClr val="10B981"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>4. Context-Blind Campus AI Chatbots</a:t></a:r></a:p><a:p><a:pPr><a:defRPr sz="1150"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>Standard generative AI models know nothing about university reality. They cannot tell students where their next lecture is located, who is teaching, or which classroom block they must report to for practical simulations.</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>